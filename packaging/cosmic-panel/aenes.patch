 impl PanelSpace {
+    /// aenes: tear down, right away, the proxied popups whose embedded popup the applet
+    /// destroyed itself. This used to wait for the next `handle_events` with a renderer, so the
+    /// real compositor kept the old popup (and its grab) around while the applet already asked
+    /// for the next one. Same cleanup as `close_popups`, without `send_popup_done` (the client
+    /// popup is already gone). Dropping the `WrapperPopup` destroys the EGL surface, then
+    /// `xdg_popup`, `xdg_surface` and `wl_surface` in protocol order (sctk `Popup` drop).
+    pub(crate) fn popup_destroyed(&mut self) {
+        let mut removed = Vec::new();
+        self.popups.retain(|p| {
+            if p.s_surface.alive() {
+                return true;
+            }
+            removed.push((
+                p.popup.c_popup.wl_surface().clone(),
+                p.s_surface.wl_surface().clone(),
+            ));
+            if let Some(w) = p.popup.fractional_scale.as_ref() {
+                w.destroy();
+            }
+            if let Some(w) = p.popup.viewport.as_ref() {
+                w.destroy();
+            }
+            false
+        });
+        if removed.is_empty() {
+            return;
+        }
+        for (c_surface, s_surface) in removed {
+            tracing::info!("Destroying popup closed by its client: {:?}", c_surface);
+            self.shared.c_focused_surface.borrow_mut().retain(|s| s.0 != c_surface);
+            self.shared.c_hovered_surface.borrow_mut().retain(|s| s.0 != c_surface);
+            self.s_focused_surface
+                .retain(|s| !s.0.wl_surface().is_some_and(|s| s.as_ref() == &s_surface));
+            self.s_hovered_surface
+                .retain(|s| !s.surface.wl_surface().is_some_and(|s| s.as_ref() == &s_surface));
+        }
+        self.is_dirty = true;
+    }
