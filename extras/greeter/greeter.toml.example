# Configuração isolada da tela de login (aenes-greeter)
# Local padrão do usuário: ~/.config/cosmic-taskbar/greeter.toml
# Aplicado via Painel de Controle ou:
#   pkexec /usr/local/bin/apply-greeter --config ~/.config/cosmic-taskbar/greeter.toml --user "$USER"

# Caminho absoluto da imagem de fundo da tela de login.
# Deixe vazio ("") para usar o papel de parede atual da sessão do usuário.
wallpaper = ""

# Formato do relógio na tela de login
clock_24h = true
show_seconds = false

# Estilo da tela de login/bloqueio: win11 | android | macos | ios | ipados
# ("editorial" vale como ios e "sidebar" como ipados; o Painel grava só os novos)
style = "win11"

# Ajustes visuais (o próprio greeter desfoca e escurece o fundo; o wallpaper
# em /var/lib/aenes-greeter/ é uma cópia fiel do original)
# blur_radius: desfoque gaussiano em pixels (0 = desativado, faixa 0..60)
blur_radius = 0
# dim_opacity: escurecimento sobre o fundo (0.0 = nenhum, 0.35 = 35%, faixa 0.0..0.85)
dim_opacity = 0.0
# card_opacity: opacidade do cartão de vidro (0.0 = sem cartão, faixa 0.0..0.95)
card_opacity = 0.0
# card_radius: raio do cartão em px (faixa 4..32)
card_radius = 16
# font_family: system | sans | mono | serif ("system" usa Inter/Nunito conforme o estilo;
#   instale com: sudo pacman -S inter-font ttf-nunito)
font_family = "system"
# font_weight: light | normal | semibold | bold
font_weight = "normal"
# clock_size: small | medium | large | huge
clock_size = "medium"

# Tema da tela de login: "dark" ou "light"
theme = "dark"

# Nome de usuário pré-selecionado na tela de login (vazio = último usuário)
default_user = ""

# Sessão padrão (vazio = última sessão usada, escolhida pelo greeter; ex: "COSMIC")
session = ""

# true  = usa /usr/local/bin/aenes-greeter (compilado de greeter/ no cosmic-taskbar)
#         + /etc/greetd/aenes-greeter.toml + /etc/systemd/system/aenes-greeter.service
#         100% isolado de /usr/bin/cosmic-greeter (atualizações do pacman não sobrescrevem)
# false = usa /usr/bin/cosmic-greeter oficial mantendo unit e configs isoladas
isolated_binary = true
