#!/bin/sh
# Acoes extras por perfil do power-profiles-daemon, adaptadas automaticamente
# ao hardware da maquina:
#
# 1) Desktop AMD Ryzen (ex: R9 + NVIDIA + CoolerControl + monitor DP-3):
#    - power-saver: CPU sem boost (teto 2,4 GHz), GPU NVIDIA no power limit
#      minimo e clocks travados (1000/810 MHz), DP-3 em 60 Hz, PCIe ASPM
#      powersave, SATA ALPM med_power_with_dipm, audio power_save=1,
#      ventoinhas CoolerControl silenciosas.
#    - balanced: CPU boost ate 4,4 GHz + EPP balance_power, GPU 200 W clocks
#      livres, DP-3 em 160 Hz, PCIe/SATA economia, CoolerControl equilibrado.
#    - performance: CPU boost total, GPU padrao, DP-3 em 160 Hz, sem economia.
#
# 2) Notebook Intel Core Ultra (Meteor Lake — ex: Core Ultra 7 155H,
#    Lenovo Yoga 7i 14 2024):
#    - power-saver (Economia maxima):
#      * intel_pstate no_turbo=1, max_perf_pct=55, EPP=power (prioriza LP-E/E cores)
#      * Intel RAPL PL1=12 W / PL2=18 W
#      * Intel Arc iGPU limitada a 800 MHz (i915/xe)
#      * PCIe ASPM powersupersave, NVMe/SATA med_power_with_dipm, audio power_save=1,
#        Wi-Fi power_save on, NMI watchdog 0, dirty_writeback_centisecs=1500
#      * Tela interna (eDP) em 60 Hz se houver modo >60 Hz
#    - balanced (Equilibrado):
#      * intel_pstate no_turbo=0, max_perf_pct=85, EPP=balance_power
#      * Intel RAPL PL1=28 W / PL2=45 W
#      * Intel Arc iGPU ate 1500 MHz
#      * PCIe ASPM powersave, SATA ALPM med_power_with_dipm, audio power_save=1,
#        Wi-Fi power_save on, dirty_writeback_centisecs=500
#    - performance (Desempenho):
#      * intel_pstate no_turbo=0, max_perf_pct=100, EPP=performance
#      * Intel RAPL PL1/PL2 no maximo do hardware (ou 45/65 W)
#      * Intel Arc iGPU no clock maximo (RP0)
#      * PCIe ASPM default, SATA ALPM max_performance, audio power_save=0,
#        Wi-Fi power_save off
#
# Chamado automaticamente pelo economia-energia-daemon.
# Uso: economia-energia power-saver | balanced | performance | off
set -u

# --- Deteccao de hardware ---
cpu_vendor=$(awk -F': ' '/^vendor_id/{print $2; exit}' /proc/cpuinfo 2>/dev/null || true)
is_intel=0
[ "$cpu_vendor" = "GenuineIntel" ] && is_intel=1
is_laptop=0
for bat in /sys/class/power_supply/BAT*; do
    [ -d "$bat" ] && is_laptop=1 && break
done

# --- Parametros Desktop AMD R9 ---
saver_gpu_clock=1000
saver_memory_clock=810
saver_cpu_khz=2400000
balanced_gpu_watts=200
balanced_cpu_khz=4400000

display_output="DP-3"
display_w=3440
display_h=1440
display_hz_saver="59.987"
display_hz_full="159.962"

# --- Parametros Intel Core Ultra 7 155H (Meteor Lake) ---
intel_saver_pl1_uw=12000000     # 12 W sustentado
intel_saver_pl2_uw=18000000     # 18 W turbo curto
intel_balanced_pl1_uw=28000000  # 28 W sustentado
intel_balanced_pl2_uw=45000000  # 45 W turbo curto
intel_perf_pl1_uw=45000000      # 45 W sustentado
intel_perf_pl2_uw=65000000      # 65 W turbo curto
intel_igpu_saver_mhz=800
intel_igpu_balanced_mhz=1500

nvidia() {
    command -v nvidia-smi >/dev/null || return 0
    nvidia-smi --query-gpu=index,power.min_limit,power.default_limit --format=csv,noheader,nounits |
        while IFS=', ' read -r index min default; do
            case "$1" in
                power-saver)
                    nvidia-smi -i "$index" -pm 1
                    nvidia-smi -i "$index" -pl "$min"
                    low=$(nvidia-smi -i "$index" --query-supported-clocks=gr --format=csv,noheader,nounits | sort -n | head -1)
                    nvidia-smi -i "$index" -lgc "${low:-0},$saver_gpu_clock"
                    low=$(nvidia-smi -i "$index" --query-supported-clocks=mem --format=csv,noheader,nounits | sort -n | head -1)
                    nvidia-smi -i "$index" -lmc "${low:-0},$saver_memory_clock"
                    ;;
                balanced)
                    target=$(awk -v t="$balanced_gpu_watts" -v mn="$min" -v df="$default" 'BEGIN {
                        if (t < mn) t = mn;
                        if (t > df) t = df;
                        printf "%.0f", t;
                    }')
                    nvidia-smi -i "$index" -pm 1
                    nvidia-smi -i "$index" -rgc
                    nvidia-smi -i "$index" -rmc
                    nvidia-smi -i "$index" -pl "$target"
                    ;;
                performance)
                    nvidia-smi -i "$index" -rgc
                    nvidia-smi -i "$index" -rmc
                    nvidia-smi -i "$index" -pl "$default"
                    nvidia-smi -i "$index" -pm 0
                    ;;
            esac
        done >/dev/null
}

amdgpu() {
    for level in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
        [ -w "$level" ] && echo "$1" > "$level" 2>/dev/null || true
    done
}

intel_igpu() {
    # $1: mhz ou "max"
    # Suporta driver i915 (gt_max_freq_mhz / gt_RP0_freq_mhz) e xe (tile0/gt0/freq0/max_freq / rp0_freq).
    for card in /sys/class/drm/card*; do
        # i915
        if [ -w "$card/gt_max_freq_mhz" ] && [ -r "$card/gt_RP0_freq_mhz" ]; then
            rp0=$(cat "$card/gt_RP0_freq_mhz" 2>/dev/null) || continue
            rpn=$(cat "$card/gt_RPn_freq_mhz" 2>/dev/null || echo 300)
            if [ "$1" = max ] || [ "$1" -ge "$rp0" ]; then
                echo "$rp0" > "$card/gt_max_freq_mhz" 2>/dev/null || true
            else
                target="$1"
                [ "$target" -lt "$rpn" ] && target="$rpn"
                echo "$target" > "$card/gt_max_freq_mhz" 2>/dev/null || true
            fi
            [ -w "$card/gt_boost_freq_mhz" ] && {
                if [ "$1" = max ] || [ "$1" -ge "$rp0" ]; then
                    echo "$rp0" > "$card/gt_boost_freq_mhz" 2>/dev/null || true
                else
                    echo "$1" > "$card/gt_boost_freq_mhz" 2>/dev/null || true
                fi
            }
        fi
        # xe (Meteor Lake / Arc em kernels recentes)
        for freq_dir in "$card"/device/tile*/gt*/freq*; do
            [ -w "$freq_dir/max_freq" ] && [ -r "$freq_dir/rp0_freq" ] || continue
            rp0=$(cat "$freq_dir/rp0_freq" 2>/dev/null) || continue
            rpn=$(cat "$freq_dir/rpn_freq" 2>/dev/null || echo 300)
            if [ "$1" = max ] || [ "$1" -ge "$rp0" ]; then
                echo "$rp0" > "$freq_dir/max_freq" 2>/dev/null || true
            else
                target="$1"
                [ "$target" -lt "$rpn" ] && target="$rpn"
                echo "$target" > "$freq_dir/max_freq" 2>/dev/null || true
            fi
        done
    done
    return 0
}

intel_rapl() {
    # $1: pl1_uw ou "max", $2: pl2_uw ou "max"
    rapl="/sys/class/powercap/intel-rapl:0"
    [ -d "$rapl" ] || return 0
    if [ -w "$rapl/constraint_0_power_limit_uw" ]; then
        max0=$(cat "$rapl/constraint_0_max_power_uw" 2>/dev/null || echo "$intel_perf_pl1_uw")
        if [ "$1" = max ] || [ "$1" -gt "$max0" ]; then
            echo "$max0" > "$rapl/constraint_0_power_limit_uw" 2>/dev/null || true
        else
            echo "$1" > "$rapl/constraint_0_power_limit_uw" 2>/dev/null || true
        fi
    fi
    if [ -w "$rapl/constraint_1_power_limit_uw" ]; then
        max1=$(cat "$rapl/constraint_1_max_power_uw" 2>/dev/null || echo "$intel_perf_pl2_uw")
        if [ "$2" = max ] || [ "$2" -gt "$max1" ]; then
            echo "$max1" > "$rapl/constraint_1_power_limit_uw" 2>/dev/null || true
        else
            echo "$2" > "$rapl/constraint_1_power_limit_uw" 2>/dev/null || true
        fi
    fi
    return 0
}

intel_perf_pct() {
    [ -w /sys/devices/system/cpu/intel_pstate/max_perf_pct ] && \
        echo "$1" > /sys/devices/system/cpu/intel_pstate/max_perf_pct 2>/dev/null || true
    return 0
}

boost() {
    # Em kernels com boost por policy (amd-pstate-epp), manter o boost global em 1
    # para o power-profiles-daemon conseguir alternar policy*/boost sem EINVAL.
    if [ -w /sys/devices/system/cpu/cpufreq/policy0/boost ]; then
        [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 1 > /sys/devices/system/cpu/cpufreq/boost
        for b in /sys/devices/system/cpu/cpufreq/policy*/boost; do
            [ -w "$b" ] && echo "$1" > "$b"
        done
    else
        [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo "$1" > /sys/devices/system/cpu/cpufreq/boost
    fi
    [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ] && echo $((1 - $1)) > /sys/devices/system/cpu/intel_pstate/no_turbo
    return 0
}

cpu_max_freq() {
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -w "$policy/scaling_max_freq" ] || continue
        hw_max=$(cat "$policy/cpuinfo_max_freq" 2>/dev/null) || continue
        if [ "$1" = max ] || [ "$1" -ge "$hw_max" ]; then
            echo "$hw_max" > "$policy/scaling_max_freq"
        else
            echo "$1" > "$policy/scaling_max_freq"
        fi
    done
    return 0
}

epp() {
    for pref in /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference; do
        [ -w "$pref" ] && echo "$1" > "$pref" 2>/dev/null || true
    done
    return 0
}

platform_pm() {
    # $1: aspm policy, $2: sata alpm policy, $3: snd_hda_intel power_save (0|1)
    if [ -w /sys/module/pcie_aspm/parameters/policy ]; then
        echo "$1" > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || \
            echo powersave > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
    fi
    for host in /sys/class/scsi_host/host*/link_power_management_policy; do
        [ -w "$host" ] && echo "$2" > "$host" 2>/dev/null || true
    done
    if [ -w /sys/module/snd_hda_intel/parameters/power_save ]; then
        echo "$3" > /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || true
    fi
    if [ -w /sys/module/snd_hda_intel/parameters/power_save_controller ]; then
        if [ "$3" = "1" ]; then
            echo Y > /sys/module/snd_hda_intel/parameters/power_save_controller 2>/dev/null || true
        else
            echo N > /sys/module/snd_hda_intel/parameters/power_save_controller 2>/dev/null || true
        fi
    fi
    return 0
}

laptop_pm() {
    # $1: wifi_ps (on|off), $2: dirty_writeback_centisecs, $3: nmi_watchdog (0|1)
    if command -v iw >/dev/null 2>&1; then
        for iface in /sys/class/net/*/wireless; do
            [ -d "$iface" ] || continue
            dev=$(basename "$(dirname "$iface")")
            iw dev "$dev" set power_save "$1" >/dev/null 2>&1 || true
        done
    fi
    [ -w /proc/sys/vm/dirty_writeback_centisecs ] && \
        echo "$2" > /proc/sys/vm/dirty_writeback_centisecs 2>/dev/null || true
    [ -w /proc/sys/kernel/nmi_watchdog ] && \
        echo "$3" > /proc/sys/kernel/nmi_watchdog 2>/dev/null || true
    return 0
}

display_refresh() {
    command -v cosmic-randr >/dev/null || return 0
    hz="$1"
    for sock in /run/user/*/wayland-[0-9]*; do
        [ -S "$sock" ] || continue
        rdir=$(dirname "$sock")
        wdisp=$(basename "$sock")
        user=$(stat -c %U "$rdir" 2>/dev/null) || continue
        runuser -u "$user" -- env XDG_RUNTIME_DIR="$rdir" WAYLAND_DISPLAY="$wdisp" \
            cosmic-randr mode "$display_output" "$display_w" "$display_h" --refresh "$hz" >/dev/null 2>&1 || true
    done
    return 0
}

fans() {
    ventoinhas=$(dirname "$0")/economia-energia-ventoinhas
    [ -x "$ventoinhas" ] || return 0
    "$ventoinhas" "$1" || logger -t economia-energia "ventoinhas: nao consegui ajustar ($1)"
    return 0
}

apply_intel_laptop() {
    case "$1" in
        power-saver | on)
            boost 0
            intel_perf_pct 55
            epp power
            intel_rapl "$intel_saver_pl1_uw" "$intel_saver_pl2_uw"
            intel_igpu "$intel_igpu_saver_mhz"
            platform_pm powersupersave med_power_with_dipm 1
            laptop_pm on 1500 0
            ;;
        balanced)
            boost 1
            intel_perf_pct 85
            epp balance_power
            intel_rapl "$intel_balanced_pl1_uw" "$intel_balanced_pl2_uw"
            intel_igpu "$intel_igpu_balanced_mhz"
            platform_pm powersave med_power_with_dipm 1
            laptop_pm on 500 0
            ;;
        performance | off)
            boost 1
            intel_perf_pct 100
            epp performance
            intel_rapl "$intel_perf_pl1_uw" "$intel_perf_pl2_uw"
            intel_igpu max
            platform_pm default max_performance 0
            laptop_pm off 500 0
            ;;
        *)
            echo "uso: $0 power-saver | balanced | performance | off" >&2
            exit 2
            ;;
    esac
}

apply_amd_desktop() {
    case "$1" in
        power-saver | on)
            boost 0
            cpu_max_freq "$saver_cpu_khz"
            platform_pm powersave med_power_with_dipm 1
            nvidia power-saver
            amdgpu low
            display_refresh "$display_hz_saver"
            fans power-saver
            ;;
        balanced)
            boost 1
            cpu_max_freq "$balanced_cpu_khz"
            epp balance_power
            platform_pm powersave med_power_with_dipm 1
            nvidia balanced
            amdgpu auto
            display_refresh "$display_hz_full"
            fans balanced
            ;;
        performance)
            boost 1
            cpu_max_freq max
            platform_pm default max_performance 0
            nvidia performance
            amdgpu auto
            display_refresh "$display_hz_full"
            fans performance
            ;;
        off)
            boost 1
            cpu_max_freq max
            platform_pm default max_performance 0
            nvidia performance
            amdgpu auto
            display_refresh "$display_hz_full"
            fans off
            ;;
        *)
            echo "uso: $0 power-saver | balanced | performance | off" >&2
            exit 2
            ;;
    esac
}

if [ "$is_intel" -eq 1 ] && [ "$is_laptop" -eq 1 ]; then
    apply_intel_laptop "${1:-}"
else
    apply_amd_desktop "${1:-}"
fi
exit 0
