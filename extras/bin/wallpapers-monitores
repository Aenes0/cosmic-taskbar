#!/usr/bin/env python3
"""Wallpapers por monitor para o COSMIC.

Gera, para cada monitor ligado, uma versão de cada imagem de ~/Imagens/wallpapers
recortada no formato exato daquele monitor (16:9, 21:9, retrato...) e aponta o
cosmic-bg de cada monitor para a sua pasta. A troca (slideshow) continua sendo do
cosmic-bg e o intervalo é escolhido em Configurações > Papel de parede; este script
só corrige a pasta de cada monitor e repassa o intervalo escolhido para todos.

Imagens que precisariam ser ampliadas mais que AMPLIACAO_MAXIMA para cobrir um
monitor ficam fora daquele monitor (evita papel de parede borrado).

Uso:
    wallpapers-monitores ativar        liga o slideshow por monitor (uma vez)
    wallpapers-monitores [sincronizar] gera recortes e corrige a config
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path, PurePosixPath

HOME = Path.home()
ORIGEM = Path(os.environ.get("WALLPAPERS_ORIGEM", HOME / "Imagens" / "wallpapers"))
CACHE = HOME / ".cache" / "wallpapers-monitores"
FOCOS = HOME / ".config" / "wallpapers-monitores" / "focos.json"
ESTADO = HOME / ".local" / "state" / "wallpapers-monitores" / "estado.json"
COSMIC_BG = HOME / ".config" / "cosmic" / "com.system76.CosmicBackground" / "v1"
COSMIC_SETTINGS = HOME / ".config" / "cosmic" / "com.system76.CosmicSettings.Wallpaper" / "v1"

AMPLIACAO_MAXIMA = 1.35
INTERVALO_PADRAO = 1800
QUALIDADE_JPEG = 95
EXTENSOES = {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tif", ".tiff"}
TRANSFORMACOES_GIRADAS = {"rotate90", "rotate270", "flipped90", "flipped270"}


# ---------------------------------------------------------------- monitores


@dataclass(frozen=True)
class Monitor:
    nome: str
    largura: int
    altura: int


def parse_kdl(texto: str) -> list[Monitor]:
    """Lê a saída de `cosmic-randr list --kdl`: monitores ligados, em pixels reais."""
    monitores = []
    atual = None
    for linha in texto.splitlines():
        linha = linha.strip()
        m = re.match(r'output "([^"]+)" enabled=#(true|false)', linha)
        if m:
            if atual and atual["ligado"] and atual["modo"]:
                monitores.append(_monitor(atual))
            atual = {"nome": m.group(1), "ligado": m.group(2) == "true", "modo": None, "girado": False}
            continue
        if atual is None:
            continue
        m = re.match(r'transform "(\w+)"', linha)
        if m:
            atual["girado"] = m.group(1) in TRANSFORMACOES_GIRADAS
            continue
        m = re.match(r"mode (\d+) (\d+) \d+ .*current=#true", linha)
        if m:
            atual["modo"] = (int(m.group(1)), int(m.group(2)))
    if atual and atual["ligado"] and atual["modo"]:
        monitores.append(_monitor(atual))
    return monitores


def _monitor(dados: dict) -> Monitor:
    largura, altura = dados["modo"]
    if dados["girado"]:
        largura, altura = altura, largura
    return Monitor(dados["nome"], largura, altura)


def detectar_monitores() -> list[Monitor]:
    saida = subprocess.run(
        ["cosmic-randr", "list", "--kdl"], capture_output=True, text=True, check=True
    ).stdout
    return parse_kdl(saida)


# ---------------------------------------------------------------- geometria


def ampliacao(src_l: int, src_a: int, mon_l: int, mon_a: int) -> float:
    """Fator de escala necessário para a imagem cobrir o monitor inteiro."""
    return max(mon_l / src_l, mon_a / src_a)


def cabe(src_l: int, src_a: int, mon_l: int, mon_a: int, maximo: float = AMPLIACAO_MAXIMA) -> bool:
    return ampliacao(src_l, src_a, mon_l, mon_a) <= maximo


def janela_recorte(
    src_l: int, src_a: int, mon_l: int, mon_a: int, foco_x: float, foco_y: float
) -> tuple[int, int, int, int]:
    """Maior retângulo da imagem com a proporção do monitor, centrado no foco."""
    proporcao = mon_l / mon_a
    if src_l / src_a > proporcao:
        alt = src_a
        larg = round(src_a * proporcao)
    else:
        larg = src_l
        alt = round(src_l / proporcao)
    esquerda = _preso(round(foco_x * src_l - larg / 2), 0, src_l - larg)
    topo = _preso(round(foco_y * src_a - alt / 2), 0, src_a - alt)
    return esquerda, topo, esquerda + larg, topo + alt


def _preso(valor: int, minimo: int, maximo: int) -> int:
    return max(minimo, min(valor, maximo))


# ---------------------------------------------------------------- config do cosmic-bg


@dataclass(frozen=True)
class Entry:
    caminho: str | None
    intervalo: int


def ler_entry(texto: str) -> Entry:
    m = re.search(r'source:\s*Path\("((?:[^"\\]|\\.)*)"\)', texto)
    caminho = re.sub(r"\\(.)", r"\1", m.group(1)) if m else None
    m = re.search(r"rotation_frequency:\s*(\d+)", texto)
    intervalo = int(m.group(1)) if m else INTERVALO_PADRAO
    return Entry(caminho, intervalo)


def _ron_str(valor: str) -> str:
    return '"' + valor.replace("\\", "\\\\").replace('"', '\\"') + '"'


def gerar_entry(saida: str, caminho: str, intervalo: int) -> str:
    return (
        "(\n"
        f"    output: {_ron_str(saida)},\n"
        f"    source: Path({_ron_str(caminho)}),\n"
        "    filter_by_theme: false,\n"
        f"    rotation_frequency: {intervalo},\n"
        "    filter_method: Lanczos,\n"
        "    scaling_mode: Zoom,\n"
        "    sampling_method: Random,\n"
        ")"
    )


def _ler_lista(texto: str) -> list[str]:
    return [re.sub(r"\\(.)", r"\1", s) for s in re.findall(r'"((?:[^"\\]|\\.)*)"', texto)]


def _gerar_lista(itens: list[str]) -> str:
    return "[\n" + "".join(f"    {_ron_str(i)},\n" for i in itens) + "]"


def gerenciado(caminho: str | None, raizes) -> bool:
    """O caminho é a pasta de wallpapers (ou um recorte dela) e não uma escolha manual?"""
    if not caminho:
        return False
    alvo = PurePosixPath(caminho)
    for raiz in raizes:
        raiz = PurePosixPath(raiz)
        if alvo == raiz or raiz in alvo.parents:
            return True
    return False


def decidir_intervalo(atuais: list[int], salvo: int | None) -> int:
    """O valor que difere do último aplicado foi o que o usuário escolheu agora."""
    if not atuais:
        return salvo if salvo is not None else INTERVALO_PADRAO
    diferentes = [f for f in atuais if f != salvo]
    return diferentes[0] if diferentes else salvo


@dataclass
class Plano:
    arquivos: dict[str, str] = field(default_factory=dict)
    intervalo: int | None = None
    ativo: bool = False


def planejar_config(
    atual: dict[str, str],
    monitores: list[Monitor],
    raizes,
    cache: str,
    salvo: int | None,
    vazios=frozenset(),
) -> Plano:
    """Decide quais chaves do cosmic-bg reescrever. Não mexe no que não é gerenciado."""
    mesmo_em_todos = atual.get("same-on-all", "false").strip() == "true"
    lista = _ler_lista(atual.get("backgrounds", "[]"))

    if mesmo_em_todos:
        todas = ler_entry(atual["all"]) if "all" in atual else None
        if todas is None or not gerenciado(todas.caminho, raizes):
            return Plano(intervalo=salvo)
        intervalos = [todas.intervalo]
        alvos = list(monitores)
    else:
        entradas = {
            nome: ler_entry(atual[f"output.{nome}"]) for nome in lista if f"output.{nome}" in atual
        }
        geridas = {n: e for n, e in entradas.items() if gerenciado(e.caminho, raizes)}
        if not geridas:
            return Plano(intervalo=salvo)
        intervalos = [e.intervalo for e in geridas.values()]
        alvos = [m for m in monitores if m.nome in geridas or m.nome not in entradas]

    intervalo = decidir_intervalo(intervalos, salvo)
    desejado = {}
    for mon in alvos:
        pasta = str(PurePosixPath(raizes[0])) if mon.nome in vazios else f"{cache}/{mon.nome}"
        desejado[f"output.{mon.nome}"] = gerar_entry(mon.nome, pasta, intervalo)

    arquivos = {k: v for k, v in desejado.items() if atual.get(k) != v}
    nova_lista = lista + [m.nome for m in alvos if m.nome not in lista]
    if nova_lista != lista:
        arquivos["backgrounds"] = _gerar_lista(nova_lista)
    if mesmo_em_todos:
        arquivos["same-on-all"] = "false"
    return Plano(arquivos, intervalo, True)


# ---------------------------------------------------------------- imagens


def e_imagem(caminho: Path) -> bool:
    return caminho.suffix.lower() in EXTENSOES


def nome_saida(nome: str) -> str:
    return PurePosixPath(nome).stem + ".jpg"


def _gerar_recorte(src: Path, destino: Path, mon: Monitor, foco) -> None:
    """Recorta e redimensiona para o tamanho exato do monitor (Lanczos)."""
    from PIL import Image

    if foco is None:
        _recorte_atencao(src, destino, mon)
        return
    with Image.open(src) as img:
        img = img.convert("RGB")
        caixa = janela_recorte(img.width, img.height, mon.largura, mon.altura, *foco)
        img.crop(caixa).resize((mon.largura, mon.altura), Image.Resampling.LANCZOS).save(
            destino, "JPEG", quality=QUALIDADE_JPEG, subsampling=0, optimize=True
        )


def _recorte_atencao(src: Path, destino: Path, mon: Monitor) -> None:
    """Sem foco definido: recorte por saliência do libvips (pega a região mais interessante)."""
    subprocess.run(
        [
            "vips", "thumbnail", str(src),
            f"{destino}[Q={QUALIDADE_JPEG},subsample-mode=off,optimize-coding]",
            str(mon.largura), "--height", str(mon.altura),
            "--crop", "attention", "--size", "both",
        ],
        check=True,
        capture_output=True,
    )


def _tamanho(src: Path) -> tuple[int, int] | None:
    from PIL import Image

    try:
        with Image.open(src) as img:
            return img.size
    except (OSError, ValueError) as erro:
        print(f"ignorada (não abre): {src.name}: {erro}")
        return None


def _ler_json(caminho: Path, padrao):
    try:
        return json.loads(caminho.read_text())
    except FileNotFoundError:
        return padrao
    except (OSError, ValueError) as erro:
        print(f"aviso: {caminho} ilegível ({erro}); usando padrão")
        return padrao


def _gravar_atomico(caminho: Path, conteudo: str) -> None:
    caminho.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=caminho.parent, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        f.write(conteudo)
    os.replace(tmp, caminho)


def sincronizar_imagens(monitores: list[Monitor]) -> set[str]:
    """Gera/atualiza as pastas por monitor. Devolve os monitores que ficaram sem imagem."""
    focos = _ler_json(FOCOS, {})
    manifesto_arq = CACHE / "manifesto.json"
    manifesto = _ler_json(manifesto_arq, {})
    fontes = sorted(p for p in ORIGEM.iterdir() if p.is_file() and e_imagem(p)) if ORIGEM.is_dir() else []
    tamanhos = {p: t for p in fontes if (t := _tamanho(p))}
    vazios = set()

    for mon in monitores:
        pasta = CACHE / mon.nome
        pasta.mkdir(parents=True, exist_ok=True)
        esperados = set()
        for src, (larg, alt) in tamanhos.items():
            if not cabe(larg, alt, mon.largura, mon.altura):
                continue
            nome = nome_saida(src.name)
            if nome in esperados:
                print(f"aviso: {src.name} tem o mesmo nome base de outra imagem; ignorada")
                continue
            esperados.add(nome)
            foco = focos.get(src.name)
            st = src.stat()
            assinatura = f"{st.st_mtime_ns}:{st.st_size}:{foco}:{mon.largura}x{mon.altura}"
            chave = f"{mon.nome}/{nome}"
            if manifesto.get(chave) == assinatura and (pasta / nome).exists():
                continue
            fd, tmp = tempfile.mkstemp(dir=CACHE, prefix=".tmp-", suffix=".jpg")
            os.close(fd)
            try:
                _gerar_recorte(src, Path(tmp), mon, foco)
                os.replace(tmp, pasta / nome)
            except Exception as erro:  # imagem corrompida/meio copiada não derruba as outras
                print(f"erro ao gerar {chave}: {erro!r}")
                Path(tmp).unlink(missing_ok=True)
                esperados.discard(nome)
                continue
            manifesto[chave] = assinatura
            print(f"gerado {chave}")
        for velho in pasta.glob("*.jpg"):
            if velho.name not in esperados:
                velho.unlink()
                manifesto.pop(f"{mon.nome}/{velho.name}", None)
                print(f"removido {mon.nome}/{velho.name}")
        if not esperados:
            vazios.add(mon.nome)

    _gravar_atomico(manifesto_arq, json.dumps(manifesto, indent=1, sort_keys=True))
    return vazios


# ---------------------------------------------------------------- execução


def _ler_config_bg() -> dict[str, str]:
    if not COSMIC_BG.is_dir():
        return {}
    return {p.name: p.read_text() for p in COSMIC_BG.iterdir() if p.is_file() and not p.name.startswith(".")}


def _monitores_com_cache(estado: dict) -> list[Monitor]:
    try:
        monitores = detectar_monitores()
    except (OSError, subprocess.CalledProcessError) as erro:
        print(f"aviso: cosmic-randr falhou ({erro}); usando monitores conhecidos")
        return [Monitor(**m) for m in estado.get("monitores", [])]
    estado["monitores"] = [m.__dict__ for m in monitores]
    return monitores


def sincronizar() -> None:
    estado = _ler_json(ESTADO, {})
    monitores = _monitores_com_cache(estado)
    if not monitores:
        print("nenhum monitor detectado; nada a fazer")
        return
    vazios = sincronizar_imagens(monitores)
    plano = planejar_config(
        _ler_config_bg(), monitores, (str(ORIGEM), str(CACHE)), str(CACHE), estado.get("intervalo"), vazios
    )
    # entradas primeiro, chave global por último: o cosmic-bg nunca vê estado pela metade
    ordem = sorted(plano.arquivos, key=lambda k: (k == "same-on-all", k == "backgrounds", k))
    for chave in ordem:
        _gravar_atomico(COSMIC_BG / chave, plano.arquivos[chave])
        print(f"config: {chave}")
    if plano.ativo:
        estado["intervalo"] = plano.intervalo
    _gravar_atomico(ESTADO, json.dumps(estado, indent=1))


def ativar() -> None:
    """Liga o slideshow e registra a pasta no Configurações (para o seletor de intervalo)."""
    origem = str(ORIGEM)
    recentes = _ler_lista((COSMIC_SETTINGS / "recent-folders").read_text()) if (
        COSMIC_SETTINGS / "recent-folders"
    ).exists() else []
    if origem not in recentes:
        recentes.insert(0, origem)
    _gravar_atomico(COSMIC_SETTINGS / "recent-folders", _gerar_lista(recentes))
    _gravar_atomico(COSMIC_SETTINGS / "current-folder", f"Some({_ron_str(origem)})")
    estado = _ler_json(ESTADO, {})
    intervalo = estado.get("intervalo") or INTERVALO_PADRAO
    _gravar_atomico(COSMIC_BG / "all", gerar_entry("all", origem, intervalo))
    _gravar_atomico(COSMIC_BG / "same-on-all", "true")
    sincronizar()


def main(argv: list[str]) -> int:
    comando = argv[1] if len(argv) > 1 else "sincronizar"
    if comando == "ativar":
        ativar()
    elif comando == "sincronizar":
        sincronizar()
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
