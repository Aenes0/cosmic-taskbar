#!/bin/sh
# Ferramenta de recorte estilo Windows (Win+Shift+S) para COSMIC/Wayland
# Lê preferências opcionais em ~/.config/cosmic-taskbar/screenshot.conf
# (gerenciadas pelo Painel de Controle do cosmic-taskbar).

LOG="$HOME/.cache/print-recorte.log"
exec 2>>"$LOG"; echo "[$(date)] chamado" >&2

pkill -x slurp && exit 0   # apertar de novo cancela uma seleção aberta
exec < /dev/null   # slurp lê áreas do stdin se não for terminal; o COSMIC deixa um pipe aberto e ele travava

# Padrões (podem ser sobrescritos por screenshot.conf)
SAVE_DIR=""
COPY_CLIPBOARD=1
OPEN_MODE="notify"
SATTY_TOOL="arrow"
SLURP_BG="00000066"
SLURP_BORDER="3daee9ff"
SLURP_FILL="3daee922"
BORDER_WIDTH=2
NOTIFY_TIMEOUT_SECS=600
PLAY_SOUND=1

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/cosmic-taskbar/screenshot.conf"
if [ -r "$CONF" ]; then
    # shellcheck disable=SC1090
    . "$CONF"
fi

if [ -n "$SAVE_DIR" ]; then
    case "$SAVE_DIR" in
        "~/"*) DIR="$HOME/${SAVE_DIR#~/}" ;;
        *) DIR="$SAVE_DIR" ;;
    esac
else
    DIR="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
fi
mkdir -p "$DIR"
FILE="$DIR/Captura_$(date +%Y-%m-%d_%H-%M-%S).png"

GEOM="$(slurp -b "$SLURP_BG" -c "$SLURP_BORDER" -s "$SLURP_FILL" -w "$BORDER_WIDTH" < /dev/null)" || exit 0   # Esc cancela
echo "geom=$GEOM" >&2

grim -g "$GEOM" "$FILE" || { notify-send -u critical "Captura falhou" "grim não conseguiu capturar"; exit 1; }

if [ "${COPY_CLIPBOARD:-1}" = "1" ]; then
    wl-copy --type image/png < "$FILE"
fi

case "$OPEN_MODE" in
    satty)
        setsid -f satty --filename "$FILE" --output-filename "$FILE" --initial-tool "${SATTY_TOOL:-arrow}" \
            --copy-command wl-copy --actions-on-enter save-to-clipboard,save-to-file,exit \
            --early-exit all --disable-notifications < /dev/null > /dev/null 2>> "$LOG"
        exit 0
        ;;
    preview)
        PT_X="${GEOM%%,*}"
        PT_REST="${GEOM#*,}"
        PT_Y="${PT_REST%% *}"
        setsid -f "$HOME/.local/bin/print-preview" "$FILE" "$PT_X" "$PT_Y" < /dev/null > /dev/null 2>> "$LOG"
        exit 0
        ;;
    silent)
        exit 0
        ;;
esac

# Largura e altura vêm do cabeçalho PNG (IHDR: bytes 16-23, big-endian).
set -- $(od -An -tu1 -j16 -N8 "$FILE")
W=$(( ($1 << 24) + ($2 << 16) + ($3 << 8) + $4 ))
H=$(( ($5 << 24) + ($6 << 16) + ($7 << 8) + $8 ))

PRAZO_MS="${PRINT_RECORTE_PRAZO_MS:-$(( NOTIFY_TIMEOUT_SECS * 1000 ))}"

# Ajudante em segundo plano: `notify-send --wait` fica escutando a notificação e imprime a chave da ação
# clicada.
setsid -f sh -c '
  FILE=$1; DIR=$2; W=$3; H=$4; LOG=$5; PRAZO_MS=$6; SATTY_TOOL=$7; PLAY_SOUND=$8
  if [ "$PLAY_SOUND" = "1" ]; then
    acao=$(notify-send --app-name="Captura de tela" --icon=applets-screenshooter \
        --expire-time="$PRAZO_MS" \
        --category=screen-capture \
        --hint=string:image-path:"$FILE" --hint=boolean:action-icons:true \
        --hint=string:sound-name:screen-capture \
        --action=default=Editar --action=editar=Editar --action=folder-open-symbolic="Abrir pasta" \
        --wait "Captura copiada" "${W}×${H} · salvo em Screenshots") \
      || { echo "[$(date)] notify-send falhou" >&2; exit 0; }
  else
    acao=$(notify-send --app-name="Captura de tela" --icon=applets-screenshooter \
        --expire-time="$PRAZO_MS" \
        --category=screen-capture \
        --hint=string:image-path:"$FILE" --hint=boolean:action-icons:true \
        --action=default=Editar --action=editar=Editar --action=folder-open-symbolic="Abrir pasta" \
        --wait "Captura copiada" "${W}×${H} · salvo em Screenshots") \
      || { echo "[$(date)] notify-send falhou" >&2; exit 0; }
  fi
  case "$acao" in
    default|editar)
      setsid -f satty --filename "$FILE" --output-filename "$FILE" --initial-tool "$SATTY_TOOL" \
          --copy-command wl-copy --actions-on-enter save-to-clipboard,save-to-file,exit \
          --early-exit all --disable-notifications \
        || echo "[$(date)] satty não abriu" >&2 ;;
    folder-open-symbolic)
      setsid -f xdg-open "$DIR" || echo "[$(date)] xdg-open não abriu" >&2 ;;
  esac
' print-recorte-ajudante "$FILE" "$DIR" "$W" "$H" "$LOG" "$PRAZO_MS" "${SATTY_TOOL:-arrow}" "${PLAY_SOUND:-1}" < /dev/null > /dev/null 2>> "$LOG"
