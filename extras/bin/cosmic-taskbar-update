#!/bin/sh
# Verifica novas versoes do cosmic-taskbar no GitHub (origin/main) e instala
# automaticamente o binario + scripts do usuario sem sobrescrever configs locais.
#
# Uso:
#   cosmic-taskbar-update           -> verifica e atualiza se houver novos commits
#   cosmic-taskbar-update --check   -> apenas verifica se ha atualizacao disponivel
#   cosmic-taskbar-update --force   -> atualiza mesmo em bateria baixa
set -u

CHECK_ONLY=0
FORCE=0
for arg in "$@"; do
    case "$arg" in
        --check) CHECK_ONLY=1 ;;
        --force) FORCE=1 ;;
        -h|--help)
            echo "Uso: $0 [--check] [--force]"
            exit 0
            ;;
    esac
done

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "Cosmic Taskbar" -i "io.github.Aenes0.CosmicCentral" "$1" "${2:-}" >/dev/null 2>&1 || true
}

log() {
    echo "cosmic-taskbar-update: $*"
}

# Evita duas execucoes simultaneas.
LOCK="/tmp/cosmic-taskbar-update-${UID:-$(id -u)}.lock"
exec 9>"$LOCK"
if ! flock -n 9; then
    log "outra verificacao ja esta em andamento."
    exit 0
fi

# Localiza o repositorio local.
REPO="${COSMIC_TASKBAR_REPO:-}"
if [ -z "$REPO" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/cosmic-taskbar/repo_path" ]; then
    REPO=$(head -1 "${XDG_CONFIG_HOME:-$HOME/.config}/cosmic-taskbar/repo_path" 2>/dev/null || true)
fi
if [ -z "$REPO" ] || [ ! -d "$REPO/.git" ]; then
    for cand in "$HOME/Projetos/cosmic-taskbar" "$HOME/cosmic-taskbar" "$HOME/Repos/cosmic-taskbar"; do
        if [ -d "$cand/.git" ]; then
            REPO="$cand"
            break
        fi
    done
fi
if [ -z "$REPO" ] || [ ! -d "$REPO/.git" ]; then
    log "repositorio cosmic-taskbar nao encontrado."
    exit 0
fi

cd "$REPO" || exit 1

# No boot a rede pode demorar alguns segundos para subir: tenta ate 6 vezes.
fetched=0
for _ in 1 2 3 4 5 6; do
    if git fetch origin main --quiet 2>/dev/null; then
        fetched=1
        break
    fi
    sleep 10
done
if [ "$fetched" -ne 1 ]; then
    log "sem acesso ao GitHub agora; tentando no proximo boot."
    exit 0
fi

LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/main)
if [ "$LOCAL" = "$REMOTE" ]; then
    log "ja esta atualizado ($(git rev-parse --short HEAD))."
    exit 0
fi

COUNT=$(git rev-list --count "$LOCAL..$REMOTE")
SUBJECT=$(git log -1 --pretty=format:%s origin/main)
SHORT=$(git rev-parse --short origin/main)

if [ "$CHECK_ONLY" -eq 1 ]; then
    log "atualizacao disponivel: $COUNT novo(s) commit(s) -> $SHORT ($SUBJECT)"
    notify "Atualizacao disponivel ($COUNT commit(s))" "$SHORT: $SUBJECT"
    exit 0
fi

# Nunca sobrescreve trabalho local nao commitado.
if [ -n "$(git status --porcelain)" ]; then
    log "ha alteracoes locais nao commitadas em $REPO; pulando atualizacao automatica."
    notify "Atualizacao pendente ($COUNT commit(s))" "Ha alteracoes locais nao commitadas em $REPO."
    exit 0
fi

# Em notebook na bateria com menos de 25%, evita compilar Rust ate conectar na tomada.
if [ "$FORCE" -ne 1 ]; then
    for bat in /sys/class/power_supply/BAT*; do
        [ -d "$bat" ] || continue
        status=$(cat "$bat/status" 2>/dev/null || true)
        cap=$(cat "$bat/capacity" 2>/dev/null || echo 100)
        if [ "$status" = "Discharging" ] && [ "$cap" -lt 25 ]; then
            log "bateria baixa (${cap}% descarregando); adiando compilacao."
            notify "Atualizacao adiada (bateria em ${cap}%)" "Conecte na tomada ou rode cosmic-taskbar-update --force."
            exit 0
        fi
    done
fi

CFG_CHANGED=0
PWR_CHANGED=0
if git diff --name-only "$LOCAL..$REMOTE" | grep -q '^config/'; then
    CFG_CHANGED=1
fi
if git diff --name-only "$LOCAL..$REMOTE" | grep -q '^extras/power/'; then
    PWR_CHANGED=1
fi

log "atualizando $LOCAL -> $REMOTE ($COUNT commits)..."
notify "Atualizando Cosmic Taskbar..." "$COUNT novo(s) commit(s) — compilando em segundo plano."

if ! git pull --ff-only origin main; then
    log "git pull --ff-only falhou (branch divergiu)."
    notify "Falha ao atualizar Cosmic Taskbar" "A branch local divergiu de origin/main."
    exit 1
fi

if ! nice -n 15 ionice -c 3 ./install.sh; then
    log "install.sh falhou."
    notify "Falha na compilacao do Cosmic Taskbar" "Verifique os logs: journalctl --user -u cosmic-taskbar-update"
    exit 1
fi

if command -v reiniciar-painel >/dev/null 2>&1; then
    reiniciar-painel >/dev/null 2>&1 || true
fi

EXTRA=""
if [ "$CFG_CHANGED" -eq 1 ]; then
    EXTRA=" • Ha novidades de config visual (rode ./scripts/sync-config.sh apply se quiser aplicar)."
fi
if [ "$PWR_CHANGED" -eq 1 ]; then
    EXTRA="${EXTRA} • Scripts de energia atualizados (reinstale extras/power com sudo se quiser)."
fi

log "atualizado com sucesso para $SHORT: $SUBJECT"
notify "Cosmic Taskbar atualizado ($SHORT)" "${SUBJECT}${EXTRA}"
exit 0
