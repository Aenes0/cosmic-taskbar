[Unit]
Description=OSD de Dispositivos (logi-osd): avisos na tela para entrada, saída e periféricos
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=@bindir@/cosmic-taskbar logi
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
