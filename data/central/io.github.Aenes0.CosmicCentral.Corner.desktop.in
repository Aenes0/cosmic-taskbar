[Desktop Entry]
Name=Central & Clock
Name[pt_BR]=Central e relógio
Comment=Quick settings, clock and show desktop
Comment[pt_BR]=Configurações rápidas, relógio e mostrar área de trabalho
Type=Application
Exec=@bindir@/cosmic-taskbar central --corner
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Corner;Central;Clock;Desktop;Canto;Relógio;
Icon=io.github.Aenes0.CosmicCentral
NoDisplay=true
X-CosmicApplet=true
X-HostWaylandDisplay=true
X-OverflowPriority=99
X-OverflowMinSize=2
